{
  "name": "tiny-vector-drawable",
  "version": "1.0.0",
  "description": "A TinyPNG-style web app for optimizing Android VectorDrawable and AnimatedVectorDrawable XML files, running entirely in the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bundle": "node build/bundle.js",
    "build": "node build/bundle.js",
    "serve": "node scripts/dev-server.mjs",
    "test": "node --test test/*.test.js",
    "test:parity": "node test/parity.js",
    "test:all": "npm test && npm run test:parity"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
